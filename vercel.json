{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/fetch.js":  { "runtime": "nodejs20.x", "maxDuration": 15 },
    "api/search.js": { "runtime": "nodejs20.x", "maxDuration": 15 }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
